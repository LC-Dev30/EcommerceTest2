        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearClienteDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearClienteDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CrearClienteDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Facturacion": {
      "post": {
        "tags": [
          "Facturacion"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearFacturaDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearFacturaDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CrearFacturaDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Ordenes": {
      "post": {
        "tags": [
          "Ordenes"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearOrdenDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearOrdenDto"
              }

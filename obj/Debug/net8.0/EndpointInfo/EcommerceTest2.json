      "patch": {
        "tags": [
          "Ordenes"
        ],
        "parameters": [
          {
            "name": "idDetalle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarCantidadDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarCantidadDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarCantidadDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Ordenes/detalle/{idDetalle}": {
      "delete": {
        "tags": [
          "Ordenes"
        ],
        "parameters": [
          {
            "name": "idDetalle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
